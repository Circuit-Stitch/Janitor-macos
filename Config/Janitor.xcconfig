// The Janitor application target.

PRODUCT_NAME = Janitor
PRODUCT_BUNDLE_IDENTIFIER = com.circuitstitch.apps.janitor

// The entitlements file is hand-written and lives in Support/.
CODE_SIGN_ENTITLEMENTS = Support/Janitor.entitlements

// Support/Info.plist is committed source. Xcode must not synthesize one over it.
GENERATE_INFOPLIST_FILE = NO

// Sources/janitor.icon is an Icon Composer bundle. The setting names its
// basename, not a path, and the bundle is picked up from the Sources tree.
ASSETCATALOG_COMPILER_APPICON_NAME = janitor

ENABLE_PREVIEWS = YES
COMBINE_HIDPI_IMAGES = YES

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
